# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=akashdip.xxx@email.com

# Database connection string (Neon / Postgres) — for packages/db
DATABASE_URL=postgresql://user:password@host/dbname

# Google Gemini / LLM Chatbot Configuration (OpenAI Compatibility Mode)
GEMINI_API_KEY=AQ.Ab8XXX
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash # Multi-Model Fallback Chain (gemini-2.5-flash → gemini-1.5-flash → gemini-1.5-flash-8b) to route.ts

# Neo4j Knowledge Graph (GraphRAG) Configuration
NEO4J_URI=neo4j+s://<YOUR_AURA_DB_INSTANCE>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>


