# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_TO_EMAIL=akashdip.xxx@email.com

# Database connection string (Neon / Postgres) — for packages/db
DATABASE_URL=postgresql://user:password@host/dbname

# Google Gemini / LLM Chatbot Configuration (OpenAI Compatibility Mode)
# GEMINI_API_KEY: Your Google AI Studio API key — get one free at https://aistudio.google.com/app/apikey
# LLM_BASE_URL: Google's OpenAI-compatible endpoint (no changes needed)
# LLM_MODEL: Primary model to call. The route.ts Multi-Model Fallback Chain will automatically
#   try the next model if this one returns 404 (not found) or 429 (rate limited).
#   Verified active fallback order: gemini-2.5-flash → gemini-flash-latest → gemini-2.0-flash → gemini-2.0-flash-lite → gemini-pro-latest
#   NOTE: gemini-1.5-flash / gemini-1.5-pro are DEPRECATED on this API key tier — do NOT use them.
#   The code reads this as: process.env.LLM_MODEL || "gemini-2.5-flash" (env var takes priority over hardcoded default)
GEMINI_API_KEY=your_google_ai_studio_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash

# Neo4j Knowledge Graph (GraphRAG) Configuration
NEO4J_URI=neo4j+s://<YOUR_AURA_DB_INSTANCE>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>


